# --- Seguridad ---
SECRET_KEY=genera-una-clave-larga-y-aleatoria-aqui
DEBUG=False
ALLOWED_HOSTS=tu-app.up.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://tu-app.up.railway.app

# --- Base de datos (Railway MySQL) ---
DB_NAME=railway
DB_USER=root
DB_PASSWORD=tu-password-de-railway
