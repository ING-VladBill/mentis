# Django
SECRET_KEY=tu_secret_key_muy_larga_y_segura_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL (XAMPP)
DB_NAME=mentis_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# OpenAI
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Gmail SMTP
EMAIL_HOST_USER=mentis.reclutamiento@gmail.com
EMAIL_HOST_PASSWORD=xxxx_xxxx_xxxx_xxxx   # App Password de Google (16 dígitos)

# Frontend URL (para links en correos)
FRONTEND_URL=http://localhost:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Token único para postulantes (horas)
