# --- Correo (Gmail) ---
EMAIL_HOST_USER=mentis.reclutamiento@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail

# --- IA ---
GEMINI_API_KEY=tu-gemini-api-key

# --- Empresa (opcional) ---
